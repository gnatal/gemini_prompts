+                    <div className="flex items-center gap-2">
+                      <span className="font-medium text-slate-800 dark:text-slate-200">Frame {i + 1}</span>
+                      <span className="min-w-0 flex-1 truncate text-slate-500 dark:text-slate-400" title={f.name}>
