+          </div>
+          <label className="flex flex-col gap-1 text-xs text-slate-700 dark:text-slate-300">
+            Speed: {fps} fps
+            <input type="range" min={2} max={24} value={fps} onChange={(e) => setFps(Number(e.target.value))} aria-label="Preview speed" />
