+                <option key={s} value={s}>
+                  {s}%
+                </option>
+              ))}
+            </select>
+          </label>
+          <label className="flex items-center gap-1">
+            <input type="checkbox" checked={pixelArt} onChange={(e) => setPixelArt(e.target.checked)} />
